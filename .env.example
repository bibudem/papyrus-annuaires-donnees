# Copier ce fichier vers .env et remplir les vraies valeurs.
# .env est dans .gitignore — ne JAMAIS commit le fichier .env lui-même.
# Toutes ces variables restent surchargeables en ligne de commande
# (--base-url / --user / --password / --community), qui ont priorité.

# URL de base de l'API REST DSpace (doit se terminer par /server/api)
DSPACE_BASE_URL=http://localhost:8080/server/api

# Identifiants admin DSpace
DSPACE_USER=dspace
DSPACE_PASSWORD=changer_ce_mot_de_passe

# UUID de la communauté où chercher automatiquement la collection Person
DSPACE_COMMUNITY=1acd99a0-6ffb-42f8-a261-30b96f3f2405
